    {
      "name": "Follow System",
      "item": [
        {
          "name": "Follow User",
          "request": {
            "method": "POST",
            "url": "http://localhost:3000/follow",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "raw": "{\n  \"follower_nickname\": \"juanpablo\",\n  \"followed_nickname\": \"messi\"\n}"
            }
          }
        },
        {
          "name": "Unfollow User",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:3000/follow",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "raw": "{\n  \"follower_nickname\": \"juanpablo\",\n  \"followed_nickname\": \"messi\"\n}"
            }
          }
        },
        {
          "name": "Get Following",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/follow/juanpablo/following"
          }
        },
        {
          "name": "Get Followers",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/follow/messi/followers"
          }
        }
