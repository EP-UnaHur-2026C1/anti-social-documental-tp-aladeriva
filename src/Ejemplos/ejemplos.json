        },
        {
          "name": "Get Tag By ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/tags/TAG_ID"
          }
        },
        {
          "name": "Update Tag",
          "request": {
            "method": "PUT",
            "url": "http://localhost:3000/tags/TAG_ID",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "raw": "{\n  \"name\": \"deportes\"\n}"
            }
          }
        },
        {
          "name": "Delete Tag",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:3000/tags/TAG_ID"
