{
  "info": {
    "name": "UnaHur Anti-Social API - Full Examples",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [

    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "url": "http://localhost:3000/users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickName\": \"juanpablo\"\n}"
            }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/users"
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/users/USER_ID"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "url": "http://localhost:3000/users/USER_ID",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickName\": \"juan_updated\"\n}"
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:3000/users/USER_ID"
          }
        }
      ]
    },

    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "url": "http://localhost:3000/posts",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "raw": "{\n  \"description\": \"Mi primer post\",\n  \"nickName\": \"juanpablo\"\n}"
            }
          }
        },
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/posts"
          }
        },
        {
          "name": "Get Post By ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/posts/POST_ID"
          }
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PUT",
            "url": "http://localhost:3000/posts/POST_ID",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "raw": "{\n  \"description\": \"Post actualizado\"\n}"
            }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:3000/posts/POST_ID"
          }
        }
      ]
    },

    {
      "name": "Comments",
      "item": [
        {
          "name": "Add Comment",
          "request": {
            "method": "POST",
            "url": "http://localhost:3000/posts/POST_ID/comments",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "raw": "{\n  \"text\": \"Excelente post\",\n  \"nickName\": \"messi\"\n}"
            }
          }
        },
        {
          "name": "Get Comments By Post",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/posts/POST_ID/comments"
          }
        },
        {
          "name": "Toggle Comment Visibility",
          "request": {
            "method": "PUT",
            "url": "http://localhost:3000/posts/POST_ID/comments/COMMENT_ID/visibility"
          }
        },
        {
          "name": "Delete Comment",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:3000/posts/POST_ID/comments/COMMENT_ID"
          }
        }
      ]
    },

    {
      "name": "Images",
      "item": [
        {
          "name": "Add Image to Post",
          "request": {
            "method": "POST",
            "url": "http://localhost:3000/posts/POST_ID/images",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "raw": "{\n  \"imageUrl\": \"https://example.com/image.jpg\"\n}"
            }
          }
        },
        {
          "name": "Get Images By Post",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/posts/POST_ID/images"
          }
        },
        {
          "name": "Delete Image",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:3000/posts/POST_ID/images/IMAGE_ID"
          }
        }
      ]
    },

    {
      "name": "Tags",
      "item": [
        {
          "name": "Create Tag",
          "request": {
            "method": "POST",
            "url": "http://localhost:3000/tags",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "raw": "{\n  \"name\": \"futbol\"\n}"
            }
          }
        },
        {
          "name": "Get All Tags",
          "request": {
            "method": "GET",
            "url": "http://localhost:3000/tags"
